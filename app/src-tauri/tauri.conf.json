{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FM27 Analyst",
  "version": "0.3.0",
  "identifier": "com.fm27analyst.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FM27 Analyst",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "center": true
      },
      {
        "label": "compact",
        "title": "FM27 Analyst — виджет",
        "url": "index.html?view=compact",
        "width": 330,
        "height": 190,
        "x": 40,
        "y": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8727 ws://127.0.0.1:8727 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "publisher": "Label777",
    "shortDescription": "AI-помощник главного тренера для Football Manager 27"
  }
}